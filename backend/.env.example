# HAVEN runtime configuration
# Copy this to .env and fill in your real credentials.

AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_key
GEMINI_MODEL=gemini-2.5-flash

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@gmail.com
SMTP_USE_TLS=true

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_SESSION_TOKEN=

HAVEN_AWS_BEDROCK_ENABLED=false
HAVEN_BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

HAVEN_AWS_SNS_ENABLED=false

# Optional app settings
HAVEN_JWT_SECRET=replace-with-prod-secret
HAVEN_JWT_EXPIRE_MINUTES=60
HAVEN_DB_PATH=./data/haven.db
